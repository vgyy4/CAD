+// The knots of a periodic parameter repeated over every period that [theMin, theMax] touches.
+// A face on a periodic surface can reach past the last knot (its seam is not at a knot) or lie
+// in another period (its pcurves shifted by one): GetRealKnots then found no end knot and kept
+// none, so Gauss-Kronrod integrated across all the spans' joins at once (hours on a fitted
+// blend of 152 C0 patches, and off by 1e-5 of the face's volume).
+static void ExtendPeriodicKnots(const double                              theMin,
+                                const double                              theMax,
+                                const double                              thePeriod,
+                                occ::handle<NCollection_HArray1<double>>& theKnots)
+{
+  const int    aLower = theKnots->Lower();
+  const int    aUpper = theKnots->Upper();
+  const double aFirst = theKnots->Value(aLower);
+  if (aUpper <= aLower || thePeriod <= 0. || (theMin >= aFirst && theMax <= aFirst + thePeriod))
+  {
+    return;
+  }
+  const double aK0 = std::floor((theMin - aFirst) / thePeriod);
+  const double aK1 = std::floor((theMax - aFirst) / thePeriod);
+  // A range over very many periods is left as it was.
+  if (!(aK1 - aK0 < 64.))
+  {
+    return;
+  }
+  const int aNbPeriods = static_cast<int>(aK1 - aK0) + 1;
+  const int aNbSpans   = aUpper - aLower;
+  occ::handle<NCollection_HArray1<double>> aKnots =
+    new NCollection_HArray1<double>(1, aNbPeriods * aNbSpans + 1);
+  int i = 1;
+  for (int k = 0; k < aNbPeriods; ++k)
+  {
+    const double aShift = (aK0 + k) * thePeriod;
+    for (int j = aLower; j < aUpper; ++j)
+    {
+      aKnots->SetValue(i++, theKnots->Value(j) + aShift);
+    }
+  }
+  aKnots->SetValue(i, theKnots->Value(aUpper) + aK1 * thePeriod);
+  theKnots = aKnots;
+}
